# Cadena de conexion de Neon (Dashboard de Neon -> Connection string -> Pooled connection)
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Clave con la que entra la ventera al panel de administracion
ADMIN_PASSWORD="cambiar-esta-clave"

# Cadena larga y aleatoria para firmar la sesion. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="cambiar-por-una-cadena-larga-y-aleatoria"
